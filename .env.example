# Copy to .env. Never commit the real thing.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres. Must be the pgvector image, plain postgres will not have the
# extension and the first migration will fail.
DATABASE_URL=postgresql+psycopg://bharatse:bharatse@localhost:5432/bharatse

# Any 32+ char random string. `openssl rand -hex 32`
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Language. Gemini is the default path: one call takes the artisan's audio and
# returns the finished listing. The other two are adapters behind the same
# interface, used when Gemini is rate limited or blocked on the venue network.
LISTING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

SARVAM_API_KEY=

# Images
REMBG_MODEL=isnet-general-use
REPLICATE_API_TOKEN=

# Pricing
PRICE_MODEL_DIR=data/models
FAIR_WAGE_PER_HOUR=60

# Craft Passport signing key. `python scripts/generate_keys.py`
PASSPORT_PRIVATE_KEY_HEX=
PASSPORT_PUBLIC_KEY_HEX=

# Supabase. Storage lives in the same project as the database.
# The service role key bypasses row level security, so it stays server side and
# is never shipped to the app.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-assets

# Image studio. Generative, not subtractive: the model redraws the piece on a
# clean ground rather than cutting the old background out.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
IMAGE_ASPECT_RATIO=1:1

# Voice to listing runs on its own key so it can stay on a free tier project.
# Enabling billing moves a project to a paid tier wholesale, and the image model
# has no free tier, so one shared key means every description bills too.
# Leave blank to reuse GEMINI_API_KEY.
GEMINI_LISTING_API_KEY=
